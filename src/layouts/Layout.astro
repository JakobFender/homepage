---
import "../styles/global.css";
import "katex/dist/katex.min.css"
import ThemeToggle from "../components/ThemeToggle.astro";
import ThemeSelector from "../components/ThemeSelector.astro";
import FabFlower from "../components/FabFlower.astro";
import Motion from "../components/Motion.astro";
import ConsoleGreeting from "../components/ConsoleGreeting.astro";
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "../config";
import { url, isRelease } from "../utils/url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bloomfolio Template",
  description = "A modern portfolio template built with Astro and DaisyUI",
} = Astro.props;

// Subtle fade between pages
const fadeAnimation = {
  old: {
    name: "fadeOut",
    duration: "200ms",
    easing: "ease-out",
    fillMode: "forwards",
  },
  new: {
    name: "fadeIn",
    duration: "200ms",
    easing: "ease-out",
    fillMode: "backwards",
  },
};

const pageTransition = {
  forwards: fadeAnimation,
  backwards: fadeAnimation,
};

const origin = Astro.url.origin;

// Release builds live under /release/<branch>/: point canonical at the production page
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const productionPath = Astro.url.pathname.slice(base.length) || "/";
const releaseName = import.meta.env.PUBLIC_RELEASE_NAME;
---

<!doctype html>
<html lang="en" transition:animate={pageTransition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <meta name="generator" content={Astro.generator} />
    {isRelease && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>

    <!-- Fonts: Besley (headings), Petrona (hero first name), Onest (body), Martian Mono (labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Besley:wght@500&family=Petrona:ital,wght@1,800&family=Onest:wght@400;500&family=Martian+Mono&display=swap"
    />

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Open Graph / Social Media -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={origin} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Canonical -->
      <link rel="canonical" href={`${siteConfig.site}${productionPath}`} />
  </head>
  <body class="min-h-screen">
    {
      isRelease && (
        <a href={siteConfig.site} class="fixed top-4 left-4 z-50 mono-label bg-base-100 border border-line rounded-xs px-2 py-1">
          Release preview{releaseName && `: ${releaseName}`}
        </a>
      )
    }
    <!-- Theme Controls - Fixed Position -->
    <div class="fixed top-4 right-4 z-50">
      {siteConfig.enableThemeSelector ? <ThemeSelector /> : <ThemeToggle />}
    </div>

    <slot />

    <Motion />
    <ConsoleGreeting />

    {
      siteConfig.extraLinks.enable && (
        <FabFlower extraLinks={siteConfig.extraLinks} />
      )
    }

    <!-- Smooth Scroll -->
    <style is:global>
      html {
        scroll-behavior: smooth;
      }

      /* Initial page load fade */
      @keyframes fadeIn {
        0% {
          opacity: 0;
        }
        100% {
          opacity: 1;
        }
      }

      @keyframes fadeOut {
        0% {
          opacity: 1;
        }
        100% {
          opacity: 0;
        }
      }

      html {
        animation: fadeIn 200ms ease-out;
        animation-fill-mode: both;
      }
    </style>
  </body>
</html>
