---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 - Page Not Found | Bloomfolio"
  description="The page you're looking for doesn't exist."
>
  <div class="min-h-screen flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-2xl mx-auto">
      <!-- Large 404 Number -->
      <p class="mono-label mb-4">Error 404</p>

      <!-- Error Title -->
      <h1 class="mb-6">Page not <em>found</em></h1>

      <!-- Error Description -->
      <p class="mb-8 text-muted">
        Oops! The page you're looking for doesn't exist or has been moved. Let's
        get you back on track.
      </p>

      <hr class="border-line" />

      <!-- Action Buttons -->
      <div class="flex gap-4 justify-center flex-wrap mt-8">
        <a href="/" class="btn btn-primary">
          Go home
        </a>
        <a href="/#projects" class="btn btn-outline">
          View projects
        </a>
      </div>

      <!-- Helpful Links -->
      <div class="flex justify-center gap-2 mt-12">
        <p class="text-sm text-muted mb-4">
          You might be looking for:
        </p>
        <div class="flex gap-3 justify-center flex-wrap text-sm">
          <a href="/blog" class="link link-hover">Blog</a>
          <span class="text-muted">·</span>
          <a href="/#about" class="link link-hover">About</a>
          <span class="text-muted">·</span>
          <a
            href="/blog/guides/bloomfolio-complete-guide"
            class="link link-hover">Documentation</a
          >
        </div>
      </div>
    </div>
  </div>
</Layout>
