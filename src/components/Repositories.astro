---
import {getCollection} from "astro:content";

const repositoryEntries = await getCollection("repositories");

// Sort by start date, most recent first
const sortedRepositories = repositoryEntries.sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

function formatPeriod(startDate: Date, endDate?: Date) {
  const options: Intl.DateTimeFormatOptions = {
    month: "short", year: "numeric",
  };
  const start = startDate.toLocaleDateString("en-US", options);
  const end = endDate ? endDate.toLocaleDateString("en-US", options) : "Present";
  return `${start} – ${end}`;
}
---

<section id="repositories" class="mx-auto max-w-[1080px] px-6 md:px-12 py-16 md:py-24">
  <div class="mb-12">
    <p class="mono-label mb-4">04 — Coursework</p>
    <h2>I like <em>building</em> things</h2>
    <p class="text-muted mt-4 max-w-[65ch]">
      During my time at university, I completed several project-based modules with concrete deliverables. I
      like to showcase some of this work here. A few projects are older, and there are many things I would
      approach differently today, so please don’t be too critical 🙂
    </p>
  </div>

  <ul class="border-b border-line">
    {sortedRepositories.map((repository) => (
      <li class="border-t border-line py-6 grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-8">
        <div class="md:col-span-3 md:pt-1.5 flex md:flex-col gap-x-3 gap-y-1">
          <time class="meta">{formatPeriod(repository.data.startDate, repository.data.endDate)}</time>
          <span class="meta">{repository.data.level}</span>
        </div>
        <div class="md:col-span-9 max-w-[65ch]">
          <h3>{repository.data.title}</h3>
          <p class="mono-label mt-1">{repository.data.module}</p>
          <p class="mt-3">{repository.data.description}</p>
          {(repository.data.sourceLink || repository.data.demoLink) && (
            <p class="mt-4 flex gap-6 text-[15px]">
              {repository.data.sourceLink && (
                <a href={repository.data.sourceLink} target="_blank" rel="noopener noreferrer" class="link">
                  Source
                </a>
              )}
              {repository.data.demoLink && (
                <a href={repository.data.demoLink} target="_blank" rel="noopener noreferrer" class="link">
                  Demo
                </a>
              )}
            </p>
          )}
        </div>
      </li>))}
  </ul>
</section>
