---
import { getCollection, render } from "astro:content";

interface Props {
  collection: "work" | "education";
  /** "timeline" alternates entries around a vertical line, "list" collapses descriptions behind the title */
  variant: "timeline" | "list";
  /** Mono label above the headline, e.g. "01 — Work" */
  sectionLabel: string;
  sectionTitle: string;
  sectionSubtitle?: string;
}

const { collection, variant, sectionLabel, sectionTitle, sectionSubtitle } = Astro.props;

// Load collection entries
const entries = await getCollection(collection);

// Sort by start date, most recent first
const sortedEntries = entries.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

function formatPeriod(startDate: Date, endDate?: Date) {
  const options: Intl.DateTimeFormatOptions = {
    month: "short",
    year: "numeric",
  };
  const start = startDate.toLocaleDateString("en-US", options);
  const end = endDate
    ? endDate.toLocaleDateString("en-US", options)
    : "Present";
  return `${start} – ${end}`;
}

// Render markdown content for each entry
const entriesWithContent = await Promise.all(
  sortedEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

const linkLabel = collection === "work" ? "Company website" : "Institution website";
---

<section id={collection}>
<div class="mx-auto max-w-[1080px] px-6 md:px-12 py-16 md:py-24">
  <div class="mb-12" data-reveal>
    <p class="mono-label mb-4" data-count>{sectionLabel}</p>
    <h2>{sectionTitle}</h2>
    {sectionSubtitle && <p class="text-muted mt-4">{sectionSubtitle}</p>}
  </div>

  {
    variant === "timeline" ? (
      <div class="max-w-4xl mx-auto">
        <!--
          Mobile: one column with the line on the left.
          sm and up: entries alternate around a center line. Each entry spans two grid rows,
          starting one row after the previous entry, so neighbours overlap by about half.
          Each marker sits on the line at the height of its entry's title.
        -->
        <ol class="relative grid grid-cols-1 sm:grid-cols-2 sm:gap-x-16">
          <div aria-hidden="true" class="tl-line absolute top-0 bottom-0 left-[5px] sm:left-1/2 w-px bg-line"></div>
          {entriesWithContent.map(({ entry, Content }, index) => {
            const isStart = index % 2 === 0;
            return (
              <li
                data-reveal
                class={`relative pl-8 sm:pl-0 pb-12 sm:pb-8 sm:[grid-row:var(--row)/span_2] ${isStart ? "sm:col-start-1" : "sm:col-start-2"}`}
                style={`--row: ${index + 1}`}
              >
                <time class={`meta block ${isStart ? "sm:text-end" : ""}`}>
                  {formatPeriod(entry.data.startDate, entry.data.endDate)}
                </time>
                <div class="relative flex items-start gap-4 mt-3">
                  {/* Marker on the line, centered on the first line of the title */}
                  <span
                    aria-hidden="true"
                    class={`tl-marker absolute top-3 sm:top-[13px] -left-8 -translate-y-1/2 size-2.5 rounded-xs bg-accent ${
                      isStart
                        ? "sm:left-auto sm:-right-8 sm:translate-x-1/2"
                        : "sm:-translate-x-1/2"
                    }`}
                  />
                  {entry.data.logo && (
                    <img
                      src={entry.data.logo}
                      alt=""
                      class="size-10 shrink-0 object-contain rounded-xs border border-line bg-base-100"
                    />
                  )}
                  <div class="flex-1 min-w-0">
                    <h3>{entry.data.title}</h3>
                    <p class="text-muted text-left mt-1">{entry.data.subtitle}</p>
                  </div>
                </div>
                <div class="mt-4 text-[15px] leading-normal">
                  <Content />
                </div>
                {entry.data.link && (
                  <p class="mt-4 text-[15px]">
                    <a href={entry.data.link} target="_blank" rel="noopener noreferrer" class="link">
                      {linkLabel}
                    </a>
                  </p>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    ) : (
    <ul class="border-b border-line">
      {entriesWithContent.map(({ entry, Content }) => {
        const header = (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-8 w-full">
            <time class="meta md:col-span-3 md:pt-1.5">
              {formatPeriod(entry.data.startDate, entry.data.endDate)}
            </time>
            <div class="md:col-span-9 flex items-start gap-4">
              {entry.data.logo && (
                <img
                  src={entry.data.logo}
                  alt=""
                  class="size-10 shrink-0 object-contain rounded-xs border border-line bg-base-100"
                />
              )}
              <div class="flex-1">
                <h3 class="group-hover:text-primary transition-colors">{entry.data.title}</h3>
                <p class="text-muted text-left mt-1">{entry.data.subtitle}</p>
              </div>
            </div>
          </div>
        );

        const body = (
          <div class="grid grid-cols-1 md:grid-cols-12 md:gap-8">
            <div class="md:col-start-4 md:col-span-9 mt-4 text-base-content">
              <Content />
              {entry.data.link && (
                <p class="mt-4 text-[15px]">
                  <a href={entry.data.link} target="_blank" rel="noopener noreferrer" class="link">
                    {linkLabel}
                  </a>
                </p>
              )}
            </div>
          </div>
        );

        return (
          <li class="border-t border-line py-6" data-reveal>
            <details class="group smooth-details">
              <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                {header}
              </summary>
              {body}
            </details>
          </li>
        );
      })}
    </ul>
    )
  }
</div>
</section>
