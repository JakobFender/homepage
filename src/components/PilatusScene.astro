---
// Small animated scene on top of the dotted Pilatus in the .signoff space above the footer.
// Click the mountain and the cogwheel railway (the steepest in the world) climbs to the summit.
// In dark mode, stars twinkle above the ridge next to a small crescent moon. A rowboat drifts
// across the lake and a paddle steamer crosses it the other way. By day, a single-engine turboprop flies across the sky.
// The mountain itself is drawn by BackgroundDither.astro; both use src/scripts/skyline.ts.
---

<canvas class="pilatus-scene"></canvas>

<script>
  import { GRID, LAKE, ridgeAt } from "../scripts/skyline";

  const PX = 2; // CSS px per sprite pixel
  const SKY = 48; // CSS px of sky the canvas reaches above the .signoff space (see global.css)
  // Cogwheel railcar, one character per sprite pixel: # body, o wheel, space empty (windows)
  const CAR = ["########", "#  #  ##", "########", " o    o "];
  const CAR_GAP = 2; // sprite pixels between the two cars
  const CLIMB = 6000; // ms from the valley to the summit
  const REST = 1200; // ms at the summit
  const DESCEND = 4000; // ms back down
  const STAR_SPACING = 40; // CSS px of width per star
  // Rowboat with a rower, two frames for the stroke: oars raised, then level in the water
  const BOAT = [
    ["     #     ", "    ###    ", "  ## # ##  ", " ######### ", "  #######  "],
    ["     #     ", "    ###    ", "#   ###   #", " ######### ", "  #######  "],
  ];
  const STROKE = 600; // ms per oar position
  const DRIFT = 70000; // ms to cross the whole lake
  // Paddle steamer, bow to the left: funnel, two masts, a deck saloon with windows and the paddle box
  const STEAMER = [
    "   #        ##         #   ",
    "   #        ##         #   ",
    "   #     ########      #   ",
    "   #   ############    ##  ",
    " ########################  ",
    "## # # # # ##### # # # # ##",
    "###########################",
    " ######################### ",
    "   #####################   ",
  ];
  const SAIL = 90000; // ms for the steamer to cross the whole lake
  const PUFF = 900; // ms between smoke puffs
  // Single-engine turboprop with a T-tail, nose to the right; the propeller is drawn separately
  const PLANE = [
    "####              ",
    " ##               ",
    " ###############  ",
    "  ## # # # #  ####",
    "   ############## ",
    "       ######     ",
  ];
  const PROP = [["#", "#", "#"], [" ", "#", " "]]; // spinning propeller: blade across, then edge-on
  const FLIGHT = 28000; // ms to cross the sky
  const FLIGHT_GAP = 22000; // ms out of sight before the next flight
  // Crescent moon, one character per CSS px
  const MOON = ["  ####  ", " ###    ", "###     ", "###     ", "###     ", " ###    ", "  ####  "];

  let stop: (() => void) | undefined;

  function setUpScene() {
    stop?.();
    const canvas = document.querySelector<HTMLCanvasElement>(".pilatus-scene");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let width = 0;
    let height = 0;
    let pageTop = 0; // canvas top in page coordinates, to line sprites up with the dot rows
    let frame = 0;
    let trainStart = 0; // timestamp of the current trip, 0 when the train is in the depot
    let accent = "";
    let visible = false; // the scene is on screen
    let dark = document.documentElement.dataset.theme === "dark";
    type Star = { x: number; y: number; size: number; phase: number; speed: number };
    let stars: Star[] = [];
    let moon = { x: 0, y: 0 };

    // Geometry of the .signoff space, which starts SKY px below the canvas top
    const areaHeight = () => (height - SKY) * (1 - LAKE);
    // y of the mountain's crest at x, in canvas px
    const crestY = (x: number) => SKY + areaHeight() * (1 - ridgeAt(x, width, areaHeight()));
    // y of the first dot row on or below the crest, where the background draws the crest dots
    const crestDotY = (x: number) => Math.ceil((pageTop + crestY(x)) / GRID) * GRID - pageTop;

    function resize() {
      width = canvas!.clientWidth;
      height = canvas!.clientHeight;
      pageTop = canvas!.getBoundingClientRect().top + window.scrollY;
      canvas!.width = width;
      canvas!.height = height;
      placeSky();
      draw(performance.now());
    }

    // Stars at fixed pseudo-random spots in the sky above the ridge, the same on every visit
    function placeSky() {
      let seed = 7;
      const random = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
      stars = [];
      const count = Math.round(width / STAR_SPACING);
      for (let i = 0; stars.length < count && i < count * 20; i++) {
        const x = Math.round(random() * width);
        const y = Math.round(2 + random() * (height - 2));
        if (y > crestY(x) - 8) continue; // keep clear of the mountain
        // size 2: a 2px star; size 3: a bright one, drawn as a small cross
        stars.push({ x, y, size: random() < 0.2 ? 3 : 2, phase: random() * Math.PI * 2, speed: 0.6 + random() * 1.4 });
      }
      // Moon to the right of the summit, high in the sky
      const { summit } = route();
      moon = { x: Math.round(Math.min(width - 24, summit + Math.max(90, width * 0.16))), y: 6 };
    }

    function drawSky(now: number) {
      const text = getComputedStyle(document.documentElement).getPropertyValue("--color-base-content").trim();
      ctx!.fillStyle = text;
      for (const star of stars) {
        // Slow twinkle between dim and bright; still under reduced motion
        const twinkle = reduceMotion ? 0.8 : 0.55 + 0.4 * Math.sin((now / 1000) * star.speed + star.phase);
        ctx!.globalAlpha = Math.max(0.15, twinkle);
        if (star.size === 3) {
          ctx!.fillRect(star.x - 1, star.y, 3, 1);
          ctx!.fillRect(star.x, star.y - 1, 1, 3);
        } else {
          ctx!.fillRect(star.x, star.y, 2, 2);
        }
      }
      ctx!.globalAlpha = 0.9;
      MOON.forEach((row, ry) => {
        for (let rx = 0; rx < row.length; rx++) if (row[rx] === "#") ctx!.fillRect(moon.x + rx, moon.y + ry, 1, 1);
      });
      ctx!.globalAlpha = 1;
    }

    // The trip runs from the low hills left of the massif to the summit
    function route() {
      let summit = 0;
      for (let x = 0; x < width; x += 2) if (crestY(x) < crestY(summit)) summit = x;
      let valley = summit;
      while (valley > 0 && crestY(valley) < SKY + areaHeight() * 0.8) valley -= 2;
      return { valley, summit };
    }

    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);

    function trainX(now: number) {
      const elapsed = now - trainStart;
      const { valley, summit } = route();
      if (elapsed < CLIMB) return valley + (summit - valley) * ease(elapsed / CLIMB);
      if (elapsed < CLIMB + REST) return summit;
      if (elapsed < CLIMB + REST + DESCEND) return summit - (summit - valley) * ease((elapsed - CLIMB - REST) / DESCEND);
      return null;
    }

    function drawSprite(sprite: string[], x: number, bottom: number) {
      const top = Math.round(bottom) - sprite.length * PX;
      const left = Math.round(x) - (sprite[0].length * PX) / 2;
      sprite.forEach((row, ry) => {
        for (let rx = 0; rx < row.length; rx++) {
          if (row[rx] !== " ") ctx!.fillRect(left + rx * PX, top + ry * PX, PX, PX);
        }
      });
    }

    function drawTrain(now: number) {
      if (!trainStart) return;
      const x = trainX(now);
      if (x === null) {
        trainStart = 0;
        return;
      }
      ctx!.fillStyle = accent;
      // Two cars, the second one lower on the slope behind the first
      const carWidth = (CAR[0].length + CAR_GAP) * PX;
      drawSprite(CAR, x, crestDotY(x));
      drawSprite(CAR, x - carWidth, crestDotY(x - carWidth));
    }

    function drawBoat(now: number) {
      const sprite = BOAT[reduceMotion ? 1 : Math.floor(now / STROKE) % 2];
      const boatWidth = sprite[0].length * PX;
      // Drift left to right and wrap around; moored near the left shore under reduced motion
      const progress = reduceMotion ? 0.2 : (now / DRIFT + 0.3) % 1;
      const x = Math.round(-boatWidth + progress * (width + boatWidth * 2));
      // Float on the upper part of the lake, bobbing by a pixel
      const water = SKY + areaHeight() + (height - SKY - areaHeight()) * 0.45;
      const bob = reduceMotion ? 0 : Math.round(Math.sin(now / 900));
      ctx!.fillStyle = getComputedStyle(document.documentElement).getPropertyValue("--color-base-content").trim();
      ctx!.globalAlpha = 0.75;
      drawSprite(sprite, x, water + bob);
      // A short wake behind the boat
      if (!reduceMotion) {
        ctx!.globalAlpha = 0.35;
        ctx!.fillRect(x - boatWidth / 2 - 10, Math.round(water) + 1, 6, 1);
        ctx!.fillRect(x - boatWidth / 2 - 20, Math.round(water) + 2, 4, 1);
      }
      ctx!.globalAlpha = 1;
    }

    function drawSteamer(now: number) {
      const steamerWidth = STEAMER[0].length * PX;
      // Right to left and wrap around; moored near the right shore under reduced motion
      const progress = reduceMotion ? 0.8 : 1 - ((now / SAIL + 0.15) % 1);
      const x = Math.round(-steamerWidth + progress * (width + steamerWidth * 2));
      // Lower on the lake than the rowboat, so nearer to the viewer
      const water = SKY + areaHeight() + (height - SKY - areaHeight()) * 0.85;
      ctx!.fillStyle = getComputedStyle(document.documentElement).getPropertyValue("--color-base-content").trim();
      ctx!.globalAlpha = 0.75;
      drawSprite(STEAMER, x, water);
      if (reduceMotion) {
        ctx!.globalAlpha = 1;
        return;
      }
      // Smoke puffs rising from the funnel and drifting back behind the stern as they fade
      const funnelX = Math.round(x) - steamerWidth / 2 + 12 * PX;
      const funnelTop = Math.round(water) - STEAMER.length * PX;
      for (let i = 0; i < 4; i++) {
        const age = ((now / PUFF + i) % 4) / 4; // 0 fresh, 1 gone
        const size = age < 0.5 ? 2 : 3;
        ctx!.globalAlpha = 0.45 * (1 - age);
        ctx!.fillRect(funnelX + Math.round(age * 22), funnelTop - 3 - Math.round(age * 10), size, size);
      }
      // Wake behind the stern
      ctx!.globalAlpha = 0.35;
      const stern = Math.round(x) + steamerWidth / 2;
      ctx!.fillRect(stern + 4, Math.round(water) - 1, 8, 1);
      ctx!.fillRect(stern + 16, Math.round(water), 5, 1);
      ctx!.globalAlpha = 1;
    }

    function drawPlane(now: number) {
      const planeWidth = PLANE[0].length * PX;
      // Left to right across the sky, then a pause off screen; parked high on the left under reduced motion
      const t = reduceMotion ? 0.15 : ((now + FLIGHT * 0.5) % (FLIGHT + FLIGHT_GAP)) / FLIGHT;
      if (t > 1) return;
      const x = Math.round(-planeWidth + t * (width + planeWidth * 2));
      // Cruise high in the sky with a gentle rise and fall
      const bottom = 26 + (reduceMotion ? 0 : Math.round(Math.sin(now / 2500) * 2));
      ctx!.fillStyle = getComputedStyle(document.documentElement).getPropertyValue("--color-base-content").trim();
      ctx!.globalAlpha = 0.75;
      drawSprite(PLANE, x, bottom);
      // Propeller in front of the nose, flickering between two blade positions
      ctx!.globalAlpha = 0.5;
      const prop = PROP[reduceMotion ? 0 : Math.floor(now / 60) % 2];
      const noseX = Math.round(x) + planeWidth / 2;
      prop.forEach((pixel, ry) => {
        if (pixel === "#") ctx!.fillRect(noseX, Math.round(bottom) - (PLANE.length - 2 - ry) * PX, PX, PX);
      });
      ctx!.globalAlpha = 1;
    }

    function draw(now: number) {
      ctx!.clearRect(0, 0, width, height);
      if (dark) drawSky(now);
      else drawPlane(now);
      drawBoat(now);
      drawSteamer(now);
      drawTrain(now);
    }

    // Animate only while on screen and something moves; the drifting boat always does,
    // except under reduced motion, where only a train trip would
    const animating = () => visible && (trainStart > 0 || !reduceMotion);

    function tick(now: number) {
      draw(now);
      frame = animating() ? requestAnimationFrame(tick) : 0;
    }

    function update() {
      if (animating()) {
        if (!frame) frame = requestAnimationFrame(tick);
      } else {
        draw(performance.now()); // still frame, e.g. static stars or a cleared sky
      }
    }

    // Is the point inside the mountain (below its crest, above the lake)?
    function onMountain(event: PointerEvent | MouseEvent) {
      const rect = canvas!.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      return y > crestY(x) && y < SKY + areaHeight() && ridgeAt(x, width, areaHeight()) > 0.3;
    }

    const onMove = (event: PointerEvent) => {
      canvas!.style.cursor = !reduceMotion && onMountain(event) ? "pointer" : "";
    };
    const onClick = (event: MouseEvent) => {
      if (reduceMotion || trainStart || !onMountain(event)) return;
      accent = getComputedStyle(document.documentElement).getPropertyValue("--color-primary").trim();
      trainStart = performance.now();
      update();
    };

    resize();
    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(canvas);
    const visibilityObserver = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      update();
    });
    visibilityObserver.observe(canvas);
    // Stars come out when the theme toggle switches to dark
    const themeObserver = new MutationObserver(() => {
      dark = document.documentElement.dataset.theme === "dark";
      update();
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    canvas.addEventListener("pointermove", onMove);
    canvas.addEventListener("click", onClick);
    stop = () => {
      cancelAnimationFrame(frame);
      resizeObserver.disconnect();
      visibilityObserver.disconnect();
      themeObserver.disconnect();
      canvas.removeEventListener("pointermove", onMove);
      canvas.removeEventListener("click", onClick);
    };
  }

  document.addEventListener("astro:page-load", setUpScene);
</script>
