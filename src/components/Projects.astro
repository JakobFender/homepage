---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

const projectEntries = await getCollection("projects");

// Sort by start date, most recent first
const sortedProjects = projectEntries.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);
---

<section id="projects" class="mx-auto max-w-[1080px] px-6 md:px-12 py-16 md:py-24">
  <div class="mb-12">
    <p class="mono-label mb-4">03 — Projects</p>
    <h2>Selected projects</h2>
    <p class="text-muted mt-4 max-w-[65ch]">
      I've worked on a variety of projects, from simple web applications to complex knowledge
      distillation pipelines. Here are a few of my favorites.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
    {sortedProjects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
