---
import { Image } from "astro:assets";

interface Props {
  name: string;
  title: string;
  description: string;
  avatar: any;
  location?: string;
  socialLinks?: {
    github?: string;
    linkedin?: string;
    twitter?: string;
    bluesky?: string;
    instagram?: string;
    youTube?: string;
    codetips?: string;
  };
}

const { name, title, description, avatar, location, socialLinks } = Astro.props;

// The first name is the only highlighted word on the site
const [firstName, ...restOfName] = name.split(" ");

const socialLabels: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
  twitter: "X",
  bluesky: "Bluesky",
  instagram: "Instagram",
  youTube: "YouTube",
  codetips: "CodeTips",
};

const links = Object.entries(socialLinks ?? {}).filter(
  (entry): entry is [string, string] => Boolean(entry[1])
);
---

<section class="mx-auto max-w-[1080px] px-6 md:px-12 pt-24 md:pt-32">
  <div class="grid grid-cols-1 lg:grid-cols-12 lg:gap-12 lg:items-end">
    <div class="lg:col-span-8 order-2 lg:order-1 pt-8 lg:pt-0">
      <p class="mono-label mb-6">{title}</p>
      <h1 class="mb-6">
        Hi, I'm <em class="name">{firstName}</em>{restOfName.length > 0 && ` ${restOfName.join(" ")}`}.
      </h1>
      <p class="mb-4">{description}</p>
      {location && <p class="meta mb-8">{location}</p>}
      {
        links.length > 0 && (
          <ul class="flex flex-wrap gap-x-6 gap-y-2">
            {links.map(([key, href]) => (
              <li>
                <a href={href} target="_blank" rel="noopener noreferrer" class="link">
                  {socialLabels[key] ?? key}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <!-- Cut-out portrait, bottom-aligned with the hero text -->
    <div class="lg:col-span-4 order-1 lg:order-2 flex justify-start lg:justify-end">
      <Image
        src={avatar}
        alt={name}
        class="block h-64 lg:h-[360px] w-auto"
        loading="eager"
      />
    </div>
  </div>
</section>
