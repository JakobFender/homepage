---
import { Image } from "astro:assets";

interface Props {
  name: string;
  title: string;
  description: string;
  avatar: any;
  location?: string;
  socialLinks?: {
    github?: string;
    linkedin?: string;
    twitter?: string;
    bluesky?: string;
    instagram?: string;
    youTube?: string;
    codetips?: string;
  };
}

const { name, title, description, avatar, location, socialLinks } = Astro.props;

// Emphasize the first name: one olive italic word per headline
const [firstName, ...restOfName] = name.split(" ");

const socialLabels: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
  twitter: "X",
  bluesky: "Bluesky",
  instagram: "Instagram",
  youTube: "YouTube",
  codetips: "CodeTips",
};

const links = Object.entries(socialLinks ?? {}).filter(
  (entry): entry is [string, string] => Boolean(entry[1])
);
---

<section class="mx-auto max-w-[1080px] px-6 md:px-12 min-h-[75vh] flex items-center pt-24 pb-8 md:pt-32 md:pb-12">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center w-full">
    <div class="md:col-span-8 order-2 md:order-1">
      <p class="mono-label mb-6">{title}</p>
      <h1 class="mb-6">
        Hi, I'm <em>{firstName}</em>{restOfName.length > 0 && ` ${restOfName.join(" ")}`}.
      </h1>
      <p class="max-w-[65ch] mb-4">{description}</p>
      {location && <p class="meta mb-8">{location}</p>}
      {
        links.length > 0 && (
          <ul class="flex flex-wrap gap-x-6 gap-y-2">
            {links.map(([key, href]) => (
              <li>
                <a href={href} target="_blank" rel="noopener noreferrer" class="link">
                  {socialLabels[key] ?? key}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <div class="md:col-span-4 order-1 md:order-2">
      <Image
        src={avatar}
        alt={name}
        class="w-40 md:w-full max-w-[280px] aspect-square object-cover rounded-xs border border-line"
      />
    </div>
  </div>
</section>
