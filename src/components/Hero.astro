---
import { Image } from "astro:assets";

interface Props {
  name: string;
  title: string;
  description: string;
  avatar: any;
  location?: string;
  socialLinks?: {
    github?: string;
    linkedin?: string;
    twitter?: string;
    bluesky?: string;
    instagram?: string;
    youTube?: string;
    codetips?: string;
  };
}

const { name, title, description, avatar, location, socialLinks } = Astro.props;

// The first name is the only highlighted word on the site
const [firstName, ...restOfName] = name.split(" ");

const socialLabels: Record<string, string> = {
  github: "GitHub",
  linkedin: "LinkedIn",
  twitter: "X",
  bluesky: "Bluesky",
  instagram: "Instagram",
  youTube: "YouTube",
  codetips: "CodeTips",
};

const links = Object.entries(socialLinks ?? {}).filter(
  (entry): entry is [string, string] => Boolean(entry[1])
);
---

<section class="mx-auto max-w-[1080px] px-6 md:px-12 pt-24 md:pt-32">
  <div class="grid grid-cols-1 lg:grid-cols-12 lg:gap-12 lg:items-end">
    <div class="lg:col-span-8 order-2 lg:order-1 pt-8 lg:pt-0">
      <p class="mono-label mb-6 hero-in" style="--d: 0ms">{title}</p>
      <h1 class="mb-6 hero-in" style="--d: 80ms">
        <span data-greeting aria-live="polite">Hi</span>, I'm <button
          type="button"
          class="greet"
          aria-label={`${firstName}: say hi in another language`}
          data-greet><em class="name">{firstName}</em></button
        >{restOfName.length > 0 && ` ${restOfName.join(" ")}`}.
      </h1>
      <p class="mb-4 hero-in" style="--d: 160ms">{description}</p>
      {location && <p class="meta mb-8 hero-in" style="--d: 220ms">{location}</p>}
      {
        links.length > 0 && (
          <ul class="flex flex-wrap gap-x-6 gap-y-2 hero-in" style="--d: 280ms">
            {links.map(([key, href]) => (
              <li>
                <a href={href} target="_blank" rel="noopener noreferrer" class="link">
                  {socialLabels[key] ?? key}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <!-- Cut-out portrait, bottom-aligned with the hero text -->
    <div class="lg:col-span-4 order-1 lg:order-2 flex justify-start lg:justify-end hero-portrait">
      <div class="relative" data-portrait>
        <Image
          src={avatar}
          alt={name}
          class="block h-64 lg:h-[360px] w-auto"
          loading="eager"
        />
        <!-- Interactive copy of the portrait: its pixels drift away from the cursor (script below) -->
        <canvas class="absolute inset-0 w-full h-full" aria-hidden="true" hidden></canvas>
      </div>
    </div>
  </div>
</section>

<script>
  // The portrait is cut into small tiles drawn on a canvas. On load it develops from coarse blocks
  // to full detail. Afterwards, tiles near the cursor drift away from it
  // and ease back home (no overshoot) once it moves on. The static <img> stays for no-JS,
  // reduced motion and screen readers; the canvas only replaces it visually once it has drawn.
  const TILE = 4; // CSS px per tile
  const RADIUS = 72; // CSS px around the cursor that pushes tiles
  const PUSH = 12; // max drift in CSS px
  const EASE = 0.18; // fraction of the remaining distance covered per frame
  // On load the portrait "develops": it starts as coarse blocks that get finer, like a photo developing
  const DEVELOP_BLOCKS = [32, 20, 14, 10, 7, 5, 3, 2]; // CSS px per block, one step each
  const DEVELOP_STEP = 75; // ms per step, about 600ms in total
  const DEVELOP_DELAY = 250; // ms, so it starts with the rest of the hero sequence

  let stop: (() => void) | undefined;

  function setUpPortrait() {
    stop?.();
    const wrapper = document.querySelector<HTMLElement>("[data-portrait]");
    const img = wrapper?.querySelector("img");
    const canvas = wrapper?.querySelector("canvas");
    if (!wrapper || !img || !canvas) return;
    // CSS hides the static portrait while JS can develop it; show it again whenever the canvas can't run
    const showStatic = () => img.classList.add("is-static");
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return showStatic();
    const ctx = canvas.getContext("2d");
    if (!ctx) return showStatic();

    // Source image rendered once at display resolution; tiles are copied from it
    const source = document.createElement("canvas");
    const sourceCtx = source.getContext("2d")!;

    // k varies the push per tile so the pixels scatter like dust instead of a perfect radial star
    type Tile = { x: number; y: number; dx: number; dy: number; k: number };
    let tiles: Tile[] = [];
    let width = 0;
    let height = 0;
    let dpr = 1;
    let pointer: { x: number; y: number } | null = null;
    let frame = 0;
    let developing = true;
    let developTimer = 0;

    function layout() {
      width = img!.clientWidth;
      height = img!.clientHeight;
      if (!width || !height) return false;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      for (const c of [canvas!, source]) {
        c.width = Math.round(width * dpr);
        c.height = Math.round(height * dpr);
      }
      sourceCtx.clearRect(0, 0, source.width, source.height);
      sourceCtx.drawImage(img!, 0, 0, source.width, source.height);

      // Skip fully transparent tiles so only the visible portrait is animated
      const alpha = sourceCtx.getImageData(0, 0, source.width, source.height).data;
      tiles = [];
      const step = TILE * dpr;
      for (let y = 0; y < height; y += TILE) {
        for (let x = 0; x < width; x += TILE) {
          const px = Math.min(Math.round(x * dpr + step / 2), source.width - 1);
          const py = Math.min(Math.round(y * dpr + step / 2), source.height - 1);
          let visible = alpha[(py * source.width + px) * 4 + 3] > 0;
          if (!visible) {
            // Check the corners too so tiles on the outline are kept
            for (const [ox, oy] of [[0, 0], [step - 1, 0], [0, step - 1], [step - 1, step - 1]]) {
              const cx = Math.min(Math.round(x * dpr + ox), source.width - 1);
              const cy = Math.min(Math.round(y * dpr + oy), source.height - 1);
              if (alpha[(cy * source.width + cx) * 4 + 3] > 0) {
                visible = true;
                break;
              }
            }
          }
          if (visible) tiles.push({ x, y, dx: 0, dy: 0, k: 0.55 + Math.random() * 0.45 });
        }
      }
      return true;
    }

    function draw() {
      ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
      const size = TILE * dpr;
      for (const t of tiles) {
        const sx = t.x * dpr;
        const sy = t.y * dpr;
        // Whole device pixels keep the dither crisp and avoid seams between tiles
        const ox = Math.round(t.dx * dpr);
        const oy = Math.round(t.dy * dpr);
        ctx!.drawImage(source, sx, sy, size, size, sx + ox, sy + oy, size, size);
      }
    }

    function tick() {
      frame = 0;
      let moving = false;
      for (const t of tiles) {
        let tx = 0;
        let ty = 0;
        if (pointer) {
          const cx = t.x + TILE / 2 - pointer.x;
          const cy = t.y + TILE / 2 - pointer.y;
          const distance = Math.hypot(cx, cy);
          if (distance < RADIUS && distance > 0) {
            // Smooth falloff: strongest at the cursor, zero at the edge of the radius
            const force = (0.5 + 0.5 * Math.cos((Math.PI * distance) / RADIUS)) * PUSH * t.k;
            tx = (cx / distance) * force;
            ty = (cy / distance) * force;
          }
        }
        t.dx += (tx - t.dx) * EASE;
        t.dy += (ty - t.dy) * EASE;
        if (Math.abs(tx - t.dx) > 0.05 || Math.abs(ty - t.dy) > 0.05) {
          moving = true;
        } else {
          t.dx = tx;
          t.dy = ty;
        }
      }
      draw();
      if (moving) frame = requestAnimationFrame(tick);
    }

    const schedule = () => {
      if (!frame && !developing) frame = requestAnimationFrame(tick);
    };

    // Draw the portrait as blocks of the given size: downscale with smoothing (averages each block),
    // then upscale without it so the blocks stay crisp squares
    const small = document.createElement("canvas");
    const smallCtx = small.getContext("2d")!;
    function drawBlocks(block: number) {
      small.width = Math.ceil(width / block);
      small.height = Math.ceil(height / block);
      smallCtx.imageSmoothingEnabled = true;
      smallCtx.clearRect(0, 0, small.width, small.height);
      smallCtx.drawImage(source, 0, 0, small.width * block * dpr, small.height * block * dpr, 0, 0, small.width, small.height);
      ctx!.imageSmoothingEnabled = false;
      ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
      ctx!.drawImage(small, 0, 0, small.width * block * dpr, small.height * block * dpr);
      ctx!.imageSmoothingEnabled = true;
    }

    function develop(step = 0) {
      if (step >= DEVELOP_BLOCKS.length) {
        developing = false;
        draw();
        if (pointer) schedule();
        return;
      }
      drawBlocks(DEVELOP_BLOCKS[step]);
      developTimer = window.setTimeout(() => develop(step + 1), DEVELOP_STEP);
    }

    const onMove = (event: PointerEvent) => {
      const rect = canvas!.getBoundingClientRect();
      pointer = { x: event.clientX - rect.left, y: event.clientY - rect.top };
      schedule();
    };
    const onLeave = () => {
      pointer = null;
      schedule();
    };
    const onResize = () => {
      if (layout() && !developing) draw();
    };

    const start = () => {
      if (!layout()) return showStatic();
      ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
      canvas!.hidden = false;
      developTimer = window.setTimeout(() => develop(), DEVELOP_DELAY);
      // Listen on the wrapper's parent so the push starts a little before the cursor reaches the face
      wrapper!.parentElement!.addEventListener("pointermove", onMove);
      wrapper!.parentElement!.addEventListener("pointerleave", onLeave);
      window.addEventListener("resize", onResize);
    };

    // Develop only once the whole page has loaded, so nothing else is still popping in around it
    const whenReady = () => {
      if (!img.complete) return; // the image's own load event calls this again
      if (!img.naturalWidth) return showStatic(); // broken image: let the browser show its fallback
      if (document.readyState === "complete") start();
      else window.addEventListener("load", start, { once: true });
    };
    img.addEventListener("load", whenReady, { once: true });
    img.addEventListener("error", showStatic, { once: true });
    whenReady();

    stop = () => {
      cancelAnimationFrame(frame);
      clearTimeout(developTimer);
      wrapper!.parentElement!.removeEventListener("pointermove", onMove);
      wrapper!.parentElement!.removeEventListener("pointerleave", onLeave);
      window.removeEventListener("resize", onResize);
      window.removeEventListener("load", start);
      img.removeEventListener("load", whenReady);
      img.removeEventListener("error", showStatic);
    };
  }

  document.addEventListener("astro:page-load", setUpPortrait);

  // Clicking the name cycles through the greetings Jakob actually uses
  const GREETINGS = ["Hi", "Sali", "Grüezi", "Ciao", "Guten Morgen"];

  // Longer greetings can wrap the heading onto another line. On the first click, lock the heading to
  // its tallest variant so the page moves at most once instead of jumping while cycling.
  function reserveHeight(greeting: HTMLElement) {
    const heading = greeting.closest("h1");
    if (!heading || heading.dataset.reserved) return;
    heading.dataset.reserved = "true";
    const current = greeting.textContent;
    let tallest = 0;
    for (const text of GREETINGS) {
      greeting.textContent = text;
      tallest = Math.max(tallest, heading.offsetHeight);
    }
    greeting.textContent = current;
    heading.style.minHeight = `${tallest}px`;
  }

  // The reserved height is only valid for the current width
  window.addEventListener("resize", () => {
    const heading = document.querySelector<HTMLElement>("h1[data-reserved]");
    if (!heading) return;
    heading.style.minHeight = "";
    delete heading.dataset.reserved;
  });

  document.addEventListener("click", (event) => {
    const button = (event.target as Element).closest("[data-greet]");
    const greeting = document.querySelector<HTMLElement>("[data-greeting]");
    if (!button || !greeting) return;
    const next = GREETINGS[(GREETINGS.indexOf(greeting.textContent ?? "") + 1) % GREETINGS.length];
    reserveHeight(greeting);
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      greeting.textContent = next;
      return;
    }
    greeting.getAnimations().forEach((animation) => animation.cancel());
    const out = greeting.animate(
      [{ opacity: 1, translate: "0 0" }, { opacity: 0, translate: "0 -4px" }],
      { duration: 120, easing: "ease-in", fill: "forwards" }
    );
    out.onfinish = () => {
      greeting.textContent = next;
      out.cancel();
      greeting.animate([{ opacity: 0, translate: "0 4px" }, { opacity: 1, translate: "0 0" }], {
        duration: 180,
        easing: "cubic-bezier(0.2, 0.8, 0.2, 1)",
      });
    };
  });
</script>
