---
import {getCollection} from "astro:content";
import {ExternalLink} from "@lucide/astro";

const demoEntries = await getCollection("demos");
const sortedDemos = demoEntries.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<section id="demos" class="pb-16 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="mb-6">
      <h2 class="text-2xl font-bold mb-2">Web demos</h2>
      <p class="text-base-content/70">
        A few small interactive tools I host. These are lighter side projects, so only the live demos are linked.
      </p>
    </div>

    <ul class="flex flex-col gap-3">
      {sortedDemos.map((demo) => (
        <li>
          <a href={demo.data.demoLink}
             target="_blank"
             rel="noopener noreferrer"
             class="block rounded-box border border-base-content/10 p-4 hover:bg-base-200 transition-colors">
            <div class="flex items-center gap-2 font-semibold">
              {demo.data.title}
              <ExternalLink class="size-4 text-base-content/60" />
            </div>
            <p class="text-sm text-base-content/70 mt-1">{demo.data.description}</p>
          </a>
        </li>))}
    </ul>
  </div>
</section>
