---
import {getCollection} from "astro:content";

const demoEntries = await getCollection("demos");
const sortedDemos = demoEntries.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<section id="demos" class="mx-auto max-w-[1080px] px-6 md:px-12 pb-16 md:pb-24">
  <div class="mb-8">
    <p class="mono-label mb-4">05 — Web demos</p>
    <p class="text-muted max-w-[65ch]">
      A few small interactive tools I host. These are lighter side projects, so only the live demos are linked.
    </p>
  </div>

  <ul class="border-b border-line">
    {sortedDemos.map((demo) => (
      <li class="border-t border-line">
        <a href={demo.data.demoLink}
           target="_blank"
           rel="noopener noreferrer"
           class="group grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-8 py-6">
          <span class="meta md:col-span-3 md:pt-1">Web demo ↗</span>
          <span class="md:col-span-9 max-w-[65ch]">
            <span class="block font-medium group-hover:text-accent transition-colors">{demo.data.title}</span>
            <span class="block text-[15px] leading-normal text-muted mt-1">{demo.data.description}</span>
          </span>
        </a>
      </li>))}
  </ul>
</section>
