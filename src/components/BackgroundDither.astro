---
// A field of tiny square dots behind the whole page, ordered-dithered like the hero portrait:
// dense around the hero, thinning out down the page to a light scatter that reaches the very end,
// where the dots gather into Pilatus over Lake Lucerne, traced from a photo (in the .signoff spacer).
// Redrawn only when the page size or theme changes. A second, viewport-sized canvas lights up the
// dots near the mouse in olive, fading back like disturbed sand.
---

<canvas class="bg-dither" aria-hidden="true"></canvas>
<canvas class="bg-dither-trail" aria-hidden="true"></canvas>

<script>
  const GRID = 4; // CSS px between dot positions
  const DOT = 1; // CSS px dot size
  const MAX_DENSITY = 0.75; // share of positions filled at the densest point, around the portrait
  const FLOOR = 0.12; // share of MAX_DENSITY that remains everywhere, down to the end of the page
  const DECAY = 1400; // CSS px over which the hero density falls to about a third
  const STRENGTH = 0.35; // dot color: 0 = --color-line, 1 = --color-muted
  // Pilatus as seen from Lucerne, traced from a photo: heights above the lake shore (1 = summit),
  // sampled evenly from left to right. BACK is the rocky summit ridge, FRONT the green foothills.
  const PILATUS_BACK = [
    0.49, 0.5, 0.5, 0.51, 0.52, 0.54, 0.56, 0.57, 0.57, 0.57, 0.58, 0.59, 0.59, 0.59, 0.6, 0.62, 0.63,
    0.64, 0.64, 0.64, 0.65, 0.66, 0.67, 0.65, 0.66, 0.68, 0.69, 0.7, 0.7, 0.7, 0.72, 0.73, 0.75, 0.76,
    0.76, 0.78, 0.79, 0.8, 0.8, 0.79, 0.79, 0.81, 0.81, 0.83, 0.83, 0.85, 0.87, 0.89, 0.93, 0.93, 0.92,
    0.93, 0.95, 0.95, 0.93, 0.94, 0.93, 0.93, 0.94, 0.96, 0.96, 0.99, 1, 0.96, 0.98, 0.98, 0.99, 0.99,
    0.99, 0.98, 0.96, 0.95, 0.94, 0.94, 0.92, 0.91, 0.91, 0.92, 0.93, 0.93, 0.91, 0.91, 0.89, 0.88,
    0.87, 0.87, 0.87, 0.86, 0.87, 0.87, 0.87, 0.88, 0.87, 0.85, 0.85, 0.82, 0.84, 0.8, 0.78, 0.8, 0.79,
    0.79, 0.78, 0.78, 0.76, 0.75, 0.74, 0.72, 0.71, 0.7, 0.68, 0.66, 0.67, 0.68, 0.67, 0.66, 0.63,
    0.64, 0.64, 0.65, 0.63, 0.67, 0.68, 0.68, 0.69,
  ];
  const PILATUS_FRONT = [
    0.39, 0.4, 0.4, 0.41, 0.41, 0.41, 0.42, 0.42, 0.43, 0.43, 0.44, 0.44, 0.44, 0.45, 0.45, 0.46, 0.46,
    0.47, 0.47, 0.48, 0.48, 0.48, 0.49, 0.49, 0.5, 0.5, 0.5, 0.5, 0.51, 0.51, 0.51, 0.52, 0.52, 0.52,
    0.53, 0.53, 0.53, 0.54, 0.54, 0.54, 0.55, 0.55, 0.55, 0.55, 0.56, 0.56, 0.56, 0.56, 0.57, 0.57,
    0.57, 0.58, 0.58, 0.58, 0.58, 0.59, 0.59, 0.59, 0.6, 0.6, 0.6, 0.61, 0.61, 0.61, 0.61, 0.62, 0.62,
    0.63, 0.63, 0.64, 0.64, 0.65, 0.65, 0.66, 0.66, 0.66, 0.67, 0.67, 0.67, 0.67, 0.68, 0.68, 0.68,
    0.69, 0.69, 0.69, 0.69, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7, 0.69, 0.69, 0.69, 0.68, 0.68, 0.67, 0.67,
    0.67, 0.66, 0.66, 0.66, 0.65, 0.65, 0.65, 0.64, 0.64, 0.64, 0.64, 0.63, 0.63, 0.63, 0.62, 0.62,
    0.62, 0.62, 0.61, 0.61, 0.61, 0.6, 0.6, 0.6, 0.59,
  ];
  const PILATUS_ASPECT = 3; // drawn width as a multiple of the mountain area's height (photo: ~2.5)
  const LAKE = 0.22; // share of the sign-off area at the bottom that is lake
  // Dot colors from --color-line towards --color-muted: the far ridge lighter, the foothills darker
  const BACK_STRENGTH = 0.55;
  const FRONT_STRENGTH = 0.8;

  function sample(profile: number[], t: number) {
    const i = Math.min(Math.max(t, 0), 1) * (profile.length - 1);
    const i0 = Math.floor(i);
    const i1 = Math.min(i0 + 1, profile.length - 1);
    return profile[i0] + (profile[i1] - profile[i0]) * (i - i0);
  }

  // Heights [back, front] at page x: Pilatus in the middle, low hills easing out towards the edges
  function ridgeAt(x: number, width: number, areaHeight: number): [number, number] {
    const span = Math.min(width, PILATUS_ASPECT * areaHeight);
    const left = (width - span) / 2;
    const t = (x - left) / span;
    if (t >= 0 && t <= 1) return [sample(PILATUS_BACK, t), sample(PILATUS_FRONT, t)];
    // Outside the massif: ease from its edge height down to low hills at the page edge
    const edge = t < 0 ? 0 : 1;
    const away = t < 0 ? x / left : (width - x) / left; // 1 at the massif, 0 at the page edge
    const ease = (1 - Math.cos(Math.PI * Math.max(0, away))) / 2;
    const low = 0.1;
    const front = low + (sample(PILATUS_FRONT, edge) - low) * ease;
    const back = Math.max(front, low + 0.04 + (sample(PILATUS_BACK, edge) - low - 0.04) * ease);
    return [back, front];
  }

  const TRAIL_RADIUS = 48; // CSS px around the mouse whose dots light up
  const TRAIL_DOT = 2; // CSS px size of a lit dot, a little bigger than the field's so the olive reads
  const TRAIL_FADE = 700; // ms for a lit dot to fade back

  // 8x8 Bayer matrix: thresholds in [0, 1) that turn a smooth density into an even dot pattern
  const BAYER = Array.from({ length: 64 }, (_, i) => {
    const x = i % 8;
    const y = Math.floor(i / 8);
    let value = 0;
    for (let bit = 0, xr = x, yx = x ^ y; bit < 3; bit++, xr >>= 1, yx >>= 1) {
      value = (value << 2) | ((yx & 1) << 1) | (xr & 1);
    }
    return (value + 0.5) / 64;
  });

  // Mix two #rrggbb colors; falls back to the first color for any other format
  function mix(a: string, b: string, t: number) {
    const parse = (hex: string) => hex.match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i)?.slice(1).map((h) => parseInt(h, 16));
    const ca = parse(a);
    const cb = parse(b);
    if (!ca || !cb || t <= 0) return a;
    return `rgb(${ca.map((v, i) => Math.round(v + (cb[i] - v) * t)).join(" ")})`;
  }

  let stop: (() => void) | undefined;

  function setUpDither() {
    stop?.();
    const canvas = document.querySelector<HTMLCanvasElement>(".bg-dither");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;

    let last = "";
    // Layout of the field, kept for the trail so it lights exactly the dots that are drawn
    let field = { width: 0, height: 0, signoff: 0, cx: 0, cy: 0, reach: 1 };

    // Skyline at the end of the page: [density, dot kind] with kind 2 = far ridge, 3 = foothills
    function skyline(x: number, y: number): [number, number] {
      const { width, height, signoff } = field;
      const top = height - signoff;
      if (!signoff || y < top) return [0, 0];
      const v = (y - top) / signoff; // 0 at the top of the area, 1 at the end of the page
      const lakeTop = 1 - LAKE;
      if (v >= lakeTop) {
        // Lake: a few sparse rows of shimmer, thinning away from the shore
        const row = Math.round((y - top) / GRID);
        return [row % 2 ? 0 : 0.35 * (1 - (v - lakeTop) / LAKE), 3];
      }
      const areaHeight = signoff * lakeTop;
      const [back, front] = ridgeAt(x, width, areaHeight);
      const up = (lakeTop - v) / lakeTop; // height above the shore, 0..1 like the profiles
      // Both crests get a dot in every column so the outlines read as lines, not just as shading
      if (up <= front) {
        const fromCrest = (front - up) * areaHeight;
        return [fromCrest < GRID ? 1 : 0.6, 3];
      }
      if (up <= back) {
        const fromCrest = (back - up) * areaHeight;
        return [fromCrest < GRID ? 1 : 0.3, 2];
      }
      return [0, 0];
    }

    // 0 = no dot, 1 = field dot, 2 = far ridge, 3 = foothills and lake
    function dotAt(x: number, y: number) {
      const { cx, cy, reach } = field;
      const threshold = BAYER[((y / GRID) % 8) * 8 + ((x / GRID) % 8)];
      const [mountain, kind] = skyline(x, y);
      if (mountain > threshold) return kind;
      const hero = Math.exp(-y / DECAY);
      const proximity = Math.max(0, 1 - Math.hypot(x - cx, (y - cy) * 1.3) / reach);
      const density = MAX_DENSITY * (FLOOR + (1 - FLOOR) * hero * (0.15 + 0.85 * proximity ** 1.5));
      return density > threshold ? 1 : 0;
    }

    const hasDot = (x: number, y: number) => dotAt(x, y) > 0;

    function draw(force = false) {
      // Measure the page without the canvas itself, which would otherwise keep the old height
      canvas!.style.height = "0px";
      const width = document.documentElement.clientWidth;
      const height = document.documentElement.scrollHeight;
      canvas!.style.height = `${height}px`;
      const size = `${width}x${height}`;
      if (!force && size === last) return; // e.g. mobile URL bars resize only the viewport
      last = size;

      // One canvas pixel per CSS pixel keeps a full-page canvas within mobile size limits;
      // image-rendering: pixelated keeps the dots crisp on high-density screens
      canvas!.width = width;
      canvas!.height = height;
      ctx!.clearRect(0, 0, width, height);
      const styles = getComputedStyle(document.documentElement);
      const line = styles.getPropertyValue("--color-line").trim();
      const muted = styles.getPropertyValue("--color-muted").trim();
      const colors = [
        "",
        mix(line, muted, STRENGTH),
        mix(line, muted, BACK_STRENGTH),
        mix(line, muted, FRONT_STRENGTH),
      ];

      // Densest around where the portrait sits: right column on desktop, top left on mobile
      const cx = width >= 1024 ? width * 0.72 : width * 0.3;
      const cy = width >= 1024 ? 300 : 200;
      const reach = Math.max(width * 0.45, 520);
      const signoff = document.querySelector<HTMLElement>(".signoff")?.offsetHeight ?? 0;
      field = { width, height, signoff, cx, cy, reach };

      for (let y = 0; y < height; y += GRID) {
        for (let x = 0; x < width; x += GRID) {
          const dot = dotAt(x, y);
          if (!dot) continue;
          ctx!.fillStyle = colors[dot];
          ctx!.fillRect(x, y, DOT, DOT);
        }
      }
    }

    draw(true);
    // Page height changes with fonts loading, <details> opening and viewport width
    let timer = 0;
    const schedule = () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => draw(), 150);
    };
    const resizeObserver = new ResizeObserver(schedule);
    resizeObserver.observe(document.body);
    // Redraw in the other theme's colors when the theme toggle flips data-theme
    const themeObserver = new MutationObserver(() => draw(true));
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    const stopTrail = setUpTrail(hasDot, () => field.width);
    stop = () => {
      clearTimeout(timer);
      resizeObserver.disconnect();
      themeObserver.disconnect();
      stopTrail?.();
    };
  }

  // Light up the field's dots near the mouse in olive; they fade back over TRAIL_FADE ms.
  // Only for a real mouse and without reduced motion. Animates only while dots are lit.
  function setUpTrail(hasDot: (x: number, y: number) => boolean, fieldWidth: () => number) {
    const canvas = document.querySelector<HTMLCanvasElement>(".bg-dither-trail");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const lit = new Map<number, number>(); // dot key (y * 100000 + x) -> brightness 0..1
    let frame = 0;
    let lastTime = 0;
    let color = "";

    function resize() {
      // clientWidth/Height exclude scrollbars, matching the fixed canvas so lit dots land on the field's
      canvas!.width = document.documentElement.clientWidth;
      canvas!.height = document.documentElement.clientHeight;
    }

    function tick(time: number) {
      const dt = lastTime ? time - lastTime : 16;
      lastTime = time;
      ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
      ctx!.fillStyle = color;
      for (const [key, brightness] of lit) {
        const next = brightness - dt / TRAIL_FADE;
        if (next <= 0) {
          lit.delete(key);
          continue;
        }
        lit.set(key, next);
        ctx!.globalAlpha = next;
        const x = key % 100000;
        const y = (key - x) / 100000;
        ctx!.fillRect(x - window.scrollX, y - window.scrollY, TRAIL_DOT, TRAIL_DOT);
      }
      ctx!.globalAlpha = 1;
      if (lit.size) {
        frame = requestAnimationFrame(tick);
      } else {
        frame = 0;
        lastTime = 0;
      }
    }

    const onMove = (event: PointerEvent) => {
      if (event.pointerType !== "mouse") return;
      if (!color) color = getComputedStyle(document.documentElement).getPropertyValue("--color-primary").trim();
      const px = event.clientX + window.scrollX;
      const py = event.clientY + window.scrollY;
      const width = fieldWidth();
      const r = TRAIL_RADIUS;
      for (let y = Math.max(0, Math.ceil((py - r) / GRID) * GRID); y <= py + r; y += GRID) {
        for (let x = Math.max(0, Math.ceil((px - r) / GRID) * GRID); x <= Math.min(px + r, width - 1); x += GRID) {
          const distance = Math.hypot(x - px, y - py);
          if (distance > r || !hasDot(x, y)) continue;
          const key = y * 100000 + x;
          lit.set(key, Math.max(lit.get(key) ?? 0, 1 - distance / r));
        }
      }
      if (!frame && lit.size) frame = requestAnimationFrame(tick);
    };
    const onTheme = new MutationObserver(() => (color = ""));

    resize();
    window.addEventListener("resize", resize);
    document.addEventListener("pointermove", onMove, { passive: true });
    onTheme.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    return () => {
      cancelAnimationFrame(frame);
      window.removeEventListener("resize", resize);
      document.removeEventListener("pointermove", onMove);
      onTheme.disconnect();
      lit.clear();
    };
  }

  document.addEventListener("astro:page-load", setUpDither);
</script>
