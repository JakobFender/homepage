---
// A field of tiny square dots behind the whole page, ordered-dithered like the hero portrait:
// dense around the hero, thinning out down the page to a light scatter that reaches the very end.
// Redrawn only when the page size or theme changes. A second, viewport-sized canvas lights up the
// dots near the mouse in olive, fading back like disturbed sand.
---

<canvas class="bg-dither" aria-hidden="true"></canvas>
<canvas class="bg-dither-trail" aria-hidden="true"></canvas>

<script>
  const GRID = 4; // CSS px between dot positions
  const DOT = 1; // CSS px dot size
  const MAX_DENSITY = 0.75; // share of positions filled at the densest point, around the portrait
  const FLOOR = 0.12; // share of MAX_DENSITY that remains everywhere, down to the end of the page
  const DECAY = 1400; // CSS px over which the hero density falls to about a third
  const STRENGTH = 0.35; // dot color: 0 = --color-line, 1 = --color-muted
  const TRAIL_RADIUS = 48; // CSS px around the mouse whose dots light up
  const TRAIL_DOT = 2; // CSS px size of a lit dot, a little bigger than the field's so the olive reads
  const TRAIL_FADE = 700; // ms for a lit dot to fade back

  // 8x8 Bayer matrix: thresholds in [0, 1) that turn a smooth density into an even dot pattern
  const BAYER = Array.from({ length: 64 }, (_, i) => {
    const x = i % 8;
    const y = Math.floor(i / 8);
    let value = 0;
    for (let bit = 0, xr = x, yx = x ^ y; bit < 3; bit++, xr >>= 1, yx >>= 1) {
      value = (value << 2) | ((yx & 1) << 1) | (xr & 1);
    }
    return (value + 0.5) / 64;
  });

  // Mix two #rrggbb colors; falls back to the first color for any other format
  function mix(a: string, b: string, t: number) {
    const parse = (hex: string) => hex.match(/^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i)?.slice(1).map((h) => parseInt(h, 16));
    const ca = parse(a);
    const cb = parse(b);
    if (!ca || !cb || t <= 0) return a;
    return `rgb(${ca.map((v, i) => Math.round(v + (cb[i] - v) * t)).join(" ")})`;
  }

  let stop: (() => void) | undefined;

  function setUpDither() {
    stop?.();
    const canvas = document.querySelector<HTMLCanvasElement>(".bg-dither");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;

    let last = "";
    // Layout of the field, kept for the trail so it lights exactly the dots that are drawn
    let field = { width: 0, cx: 0, cy: 0, reach: 1 };

    function hasDot(x: number, y: number) {
      const { cx, cy, reach } = field;
      const hero = Math.exp(-y / DECAY);
      const proximity = Math.max(0, 1 - Math.hypot(x - cx, (y - cy) * 1.3) / reach);
      const density = MAX_DENSITY * (FLOOR + (1 - FLOOR) * hero * (0.15 + 0.85 * proximity ** 1.5));
      return density > BAYER[((y / GRID) % 8) * 8 + ((x / GRID) % 8)];
    }

    function draw(force = false) {
      // Measure the page without the canvas itself, which would otherwise keep the old height
      canvas!.style.height = "0px";
      const width = document.documentElement.clientWidth;
      const height = document.documentElement.scrollHeight;
      canvas!.style.height = `${height}px`;
      const size = `${width}x${height}`;
      if (!force && size === last) return; // e.g. mobile URL bars resize only the viewport
      last = size;

      // One canvas pixel per CSS pixel keeps a full-page canvas within mobile size limits;
      // image-rendering: pixelated keeps the dots crisp on high-density screens
      canvas!.width = width;
      canvas!.height = height;
      ctx!.clearRect(0, 0, width, height);
      const styles = getComputedStyle(document.documentElement);
      ctx!.fillStyle = mix(
        styles.getPropertyValue("--color-line").trim(),
        styles.getPropertyValue("--color-muted").trim(),
        STRENGTH
      );

      // Densest around where the portrait sits: right column on desktop, top left on mobile
      const cx = width >= 1024 ? width * 0.72 : width * 0.3;
      const cy = width >= 1024 ? 300 : 200;
      const reach = Math.max(width * 0.45, 520);
      field = { width, cx, cy, reach };

      for (let y = 0; y < height; y += GRID) {
        for (let x = 0; x < width; x += GRID) {
          if (hasDot(x, y)) ctx!.fillRect(x, y, DOT, DOT);
        }
      }
    }

    draw(true);
    // Page height changes with fonts loading, <details> opening and viewport width
    let timer = 0;
    const schedule = () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => draw(), 150);
    };
    const resizeObserver = new ResizeObserver(schedule);
    resizeObserver.observe(document.body);
    // Redraw in the other theme's colors when the theme toggle flips data-theme
    const themeObserver = new MutationObserver(() => draw(true));
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    const stopTrail = setUpTrail(hasDot, () => field.width);
    stop = () => {
      clearTimeout(timer);
      resizeObserver.disconnect();
      themeObserver.disconnect();
      stopTrail?.();
    };
  }

  // Light up the field's dots near the mouse in olive; they fade back over TRAIL_FADE ms.
  // Only for a real mouse and without reduced motion. Animates only while dots are lit.
  function setUpTrail(hasDot: (x: number, y: number) => boolean, fieldWidth: () => number) {
    const canvas = document.querySelector<HTMLCanvasElement>(".bg-dither-trail");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return;
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const lit = new Map<number, number>(); // dot key (y * 100000 + x) -> brightness 0..1
    let frame = 0;
    let lastTime = 0;
    let color = "";

    function resize() {
      // clientWidth/Height exclude scrollbars, matching the fixed canvas so lit dots land on the field's
      canvas!.width = document.documentElement.clientWidth;
      canvas!.height = document.documentElement.clientHeight;
    }

    function tick(time: number) {
      const dt = lastTime ? time - lastTime : 16;
      lastTime = time;
      ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
      ctx!.fillStyle = color;
      for (const [key, brightness] of lit) {
        const next = brightness - dt / TRAIL_FADE;
        if (next <= 0) {
          lit.delete(key);
          continue;
        }
        lit.set(key, next);
        ctx!.globalAlpha = next;
        const x = key % 100000;
        const y = (key - x) / 100000;
        ctx!.fillRect(x - window.scrollX, y - window.scrollY, TRAIL_DOT, TRAIL_DOT);
      }
      ctx!.globalAlpha = 1;
      if (lit.size) {
        frame = requestAnimationFrame(tick);
      } else {
        frame = 0;
        lastTime = 0;
      }
    }

    const onMove = (event: PointerEvent) => {
      if (event.pointerType !== "mouse") return;
      if (!color) color = getComputedStyle(document.documentElement).getPropertyValue("--color-primary").trim();
      const px = event.clientX + window.scrollX;
      const py = event.clientY + window.scrollY;
      const width = fieldWidth();
      const r = TRAIL_RADIUS;
      for (let y = Math.max(0, Math.ceil((py - r) / GRID) * GRID); y <= py + r; y += GRID) {
        for (let x = Math.max(0, Math.ceil((px - r) / GRID) * GRID); x <= Math.min(px + r, width - 1); x += GRID) {
          const distance = Math.hypot(x - px, y - py);
          if (distance > r || !hasDot(x, y)) continue;
          const key = y * 100000 + x;
          lit.set(key, Math.max(lit.get(key) ?? 0, 1 - distance / r));
        }
      }
      if (!frame && lit.size) frame = requestAnimationFrame(tick);
    };
    const onTheme = new MutationObserver(() => (color = ""));

    resize();
    window.addEventListener("resize", resize);
    document.addEventListener("pointermove", onMove, { passive: true });
    onTheme.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    return () => {
      cancelAnimationFrame(frame);
      window.removeEventListener("resize", resize);
      document.removeEventListener("pointermove", onMove);
      onTheme.disconnect();
      lit.clear();
    };
  }

  document.addEventListener("astro:page-load", setUpDither);
</script>
